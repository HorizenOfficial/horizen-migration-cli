    "bitcoinjs-lib": "6.1.7",
    "bs58check": "4.0.0",
    "colors": "1.4.0",
    "eip55": "2.1.1",
    "elliptic": "6.6.1",
    "ethers": "6.13.7",
    "sha3": "2.1.4",
    "tiny-secp256k1": "2.2.3",
    "zencashjs": "2.2.0"
